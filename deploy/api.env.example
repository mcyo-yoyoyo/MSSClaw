PORT=3000
CORS_ORIGIN=https://claw.example.com,http://localhost:5173
DATABASE_URL="file:./prod.db"

# 大 JSON / base64 blob（门户附件外提）
JSON_BODY_LIMIT=20mb
BLOB_MAX_BYTES=12582912
# Skill / Agent 原始包走二进制流上传，默认最多 200 MiB；不占用 JSON body 配额
PACKAGE_BLOB_MAX_BYTES=209715200
# BLOB_ROOT=/var/lib/mssclaw/blobs
# 接收完整 HTTP 请求的最长时间；200 MiB 慢速上传建议不少于 10 分钟
HTTP_REQUEST_TIMEOUT_MS=600000

# 私服建议开启：与前端 VITE_API_KEY 或偏好里的 API 密钥一致
# API_KEY=change-me-to-a-long-random-string

# 限流：内网 NAT 下多用户共享出口 IP，默认放宽；仍可用 Nginx 限流兜底
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=6000

# 同时进行的 SSE 执行流上限（演示默认；生产按真实执行并发调）
MAX_CONCURRENT_SSE=200

# Nest 侧 LLM（OpenAI 兼容 /chat/completions）。配置后执行流优先走真实模型。
# 未配置时回退工作区平台文档 llm-config（前端「模型与 API」保存）；皆无则报错（禁止脚本假完成）。
# 仅本地无模型冒烟时可临时：ALLOW_SCRIPTED_EXECUTION=1
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=1200
# ALLOW_SCRIPTED_EXECUTION=0

# AI 快讯抓取 AIHOT（公网）。内网出口受限时配置代理：
# 逻辑是「先直连，失败且配了这项才换代理重试」，没配就只走直连。
# 只有 AIHOT 这一处外部请求会用它；LLM 调用不受影响（多为内网地址，不应走代理）。
# HTTPS_PROXY=http://proxy.example.com:8080
