PORT=3000
CORS_ORIGIN=https://claw.example.com,http://localhost:5173
DATABASE_URL="file:./prod.db"

# 大 JSON 持久化（会话 / Marketplace）
JSON_BODY_LIMIT=8mb

# 私服建议开启：客户端需带 X-API-Key（前端尚未默认注入，开启前请先对接或仅内网探活）
# API_KEY=change-me-to-a-long-random-string

# 限流：每 IP 每分钟请求数
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# 同时进行的 SSE 执行流上限
MAX_CONCURRENT_SSE=80
