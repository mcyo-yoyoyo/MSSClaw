# ============================================================================
# MSS Claw · 企业统一身份登录（UniPortal / IDaaS OAuth2）配置
# ----------------------------------------------------------------------------
# 用法：复制到 apps/api/.env.oauth 后按下面的说明填写，重启 API 生效。
#
#     cp deploy/oauth.env.example apps/api/.env.oauth
#
# 填完立刻自检（不需要真人登录，也不需要有效凭据）：
#
#     curl -s http://localhost:3000/api/v1/auth/oauth/diagnostics | python3 -m json.tool
#
# 该接口会逐项告诉你哪个参数没配、配得对不对、以及服务器能不能连到 IDaaS。
# 本文件不会被 git 跟踪（.gitignore 已覆盖 .env*），可以放心填 secret。
# ============================================================================


# ---------------------------------------------------------------- 总开关 ----
# password = 账号密码登录（本地开发用，保持现状）
# oauth    = 企业统一身份登录（测试/生产用）
#
# 切成 oauth 之后，POST /api/v1/auth/login 会直接返回 403，
# 前端的离线兜底登录也会被禁用——这是防止 SSO 被绕过的硬要求。
# 出问题要紧急回退时，把这里改回 password 重启即可，前端不用重新打包。
AUTH_MODE=oauth


# -------------------------------------------------------- IDaaS 服务地址 ----
# 测试环境：https://uniportal-beta.huawei.com
# 生产环境：https://uniportal.huawei.com
# 【必填】结尾不要带斜杠
OAUTH_ISSUER_BASE=https://uniportal-beta.huawei.com


# ------------------------------------------------------------ 应用凭据 ----
# 在 IDaaS 管理平台注册应用后拿到。测试与生产通常是两套，不要混用。
# 【必填】
OAUTH_CLIENT_ID=
# 【必填】只存在服务端，绝不会下发给浏览器，也不会写进日志
OAUTH_CLIENT_SECRET=


# ---------------------------------------------------------- 回调地址 ----
# 【必填】必须与 IDaaS 注册值【逐字符一致】：协议 + 域名 + 端口 + 文根 全部要对得上。
#
#   ✅ 注册 https://claw-test.example.com  →  填 https://claw-test.example.com/oauth/callback
#   ❌ 注册 https://claw.example.com       →  填 http://...     （协议不同）
#   ❌ 注册 https://claw.example.com       →  填 https://www... （子域名不同）
#   ❌ 注册 https://claw.example.com:8443  →  填 https://claw.example.com （端口不同）
#
# 路径固定用 /oauth/callback（前端已注册该路由，Nginx 的 try_files 已覆盖，无需改配置）。
# 不要带 ? 查询串，也不要带 # 片段——诊断接口会拦下这两种写法。
OAUTH_REDIRECT_URI=https://claw-test.example.com/oauth/callback


# -------------------------------------------------------------- 退出 ----
# 【建议填】退出时先作废平台会话，再跳 IDaaS 退出并带回这个地址。
# 不填的话退出只清本地会话，下次点登录会被 SSO 静默登回，用户会觉得"退不出去"。
# 同样要求是注册域名下的地址。
OAUTH_LOGOUT_REDIRECT=https://claw-test.example.com/


# ------------------------------------------------------- 授权请求参数 ----
# 【选填】默认 base.profile，与接口文档一致，一般不用改
OAUTH_SCOPE=base.profile
# 【选填】IDaaS 登录页展现形式，默认 page
OAUTH_DISPLAY=page


# ------------------------------------------------ userinfo 字段名映射 ----
# 【多半不用填，但出问题时这里最救命】
#
# IDaaS 默认只回 uuid，其它属性由管理平台按应用配置，字段名各家不同。
# 代码已内置一批常见别名（email/mail、w3Account/account/loginName、
# userName/displayName/cn、postName/position/jobTitle、deptName/orgName …），
# 大小写和下划线都会忽略，通常能自动认出来。
#
# 万一上游用了没覆盖到的名字，先看 API 日志里这一行：
#     [oauth][xxxxxxxx] identity · email←... | 缺失[...] | 上游共 N 个字段: a,b,c...
# 把真实字段名填到下面对应项即可，【改完重启就行，不用改代码重新发版】。
# 多个候选用英文逗号分隔，按优先级从左到右。
#
# OAUTH_FIELD_EMAIL=email,mail
# OAUTH_FIELD_ACCOUNT=w3Account,account,loginName
# OAUTH_FIELD_NAME=userName,displayName,cn
# OAUTH_FIELD_EXTERNAL_ID=uuid,sub
# OAUTH_FIELD_POST=postName,position,jobTitle
# OAUTH_FIELD_ORG=deptName,orgName,orgPath

# 【选填】上游只给工号不给邮箱时，用它补成 <工号>@<域> 去匹配成员表。
# 例如上游给 w3Account=j00123456，这里填 huawei.com，就会按 j00123456@huawei.com 匹配。
# OAUTH_DEFAULT_EMAIL_DOMAIN=huawei.com


# -------------------------------------------------------- 开户与权限 ----
# 【重要】未在成员表里的人首次登录怎么办：
#   0 = 拒绝登录并提示"联系平台运营"（推荐：先导入名单，灰度稳定后再开）
#   1 = 自动建号
OAUTH_JIT_PROVISION=0

# 自动建号时给的角色。【绝不允许】填 super_admin / capability_ops：
# 提权只能由运营在「组织权限」页手工操作，不能由上游字段决定。
OAUTH_DEFAULT_ROLE=business_user

# 【开了 JIT 就必须填】允许自动建号的邮箱域，逗号分隔。
# 不填等于任何能通过 IDaaS 的账号都会被建号。
OAUTH_ALLOWED_EMAIL_DOMAINS=huawei.com


# ------------------------------------------------------------ 会话 ----
# 【选填】平台会话有效期（小时），默认 12。
# 比密码登录的 7 天短，是为了让 IDaaS 侧停用的账号能较快失效。
OAUTH_SESSION_TTL_HOURS=12

# 【选填】state（防重放随机串）有效期，毫秒，默认 600000（10 分钟）。
# 用户从点登录到 IDaaS 那边输完密码回来的最长时间，一般不用改。
OAUTH_STATE_TTL_MS=600000


# -------------------------------------------------------------- 网络 ----
# 【选填】调 IDaaS 接口的超时，毫秒，默认 8000。内网慢可调大。
OAUTH_HTTP_TIMEOUT_MS=8000

# 【按需】服务器到 IDaaS 是否需要经代理出网：
#   0 = 直连（先试这个）
#   1 = 直连失败后自动回退到 HTTPS_PROXY 指定的代理
# 不确定就先填 0，然后打 diagnostics 接口看 upstream 那一项能不能通。
OAUTH_PROXY_ENABLED=0
# 开了上面的开关才用得上；apps/api/.env 里若已有 HTTPS_PROXY 会被复用
# HTTPS_PROXY=http://proxyjp.huawei.com:8080


# -------------------------------------------------------- 排障开关 ----
# 【选填】诊断接口 /api/v1/auth/oauth/diagnostics 开关，默认开。
# 它只回配置项的"有没有配/格式对不对"，不会回 secret 值本身。
# 上线稳定后可以改成 0 关掉。
OAUTH_DIAGNOSTICS=1

# 【临时排障用，默认关】打开后把 userinfo 的原始 JSON 完整写进 API 日志。
# 里面含真实个人信息（姓名/工号/岗位），查完字段名就【立刻改回 0】。
OAUTH_DEBUG_USERINFO=0
