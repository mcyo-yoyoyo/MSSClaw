{
  "name": "mss-claw-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mss-claw/web",
    "dev:prototype": "npm run dev:prototype --workspace @mss-claw/web",
    "dev:react": "npm run dev:react --workspace @mss-claw/web",
    "dev:api": "node apps/api/scripts/start-api.mjs local",
    "dev:api:local": "node apps/api/scripts/start-api.mjs local",
    "dev:web:local": "npm run dev:react --workspace @mss-claw/web -- --mode local",
    "build": "npm run build --workspace @mss-claw/web",
    "build:prototype": "npm run build:prototype --workspace @mss-claw/web",
    "build:react": "npm run build:react --workspace @mss-claw/web",
    "build:api": "npm run build --workspace @mss-claw/api",
    "build:web:test": "npm run build:react --workspace @mss-claw/web -- --mode test",
    "build:web:prod": "npm run build:react --workspace @mss-claw/web -- --mode production",
    "start:api:test": "node apps/api/scripts/start-api.mjs test",
    "start:web:test": "npm run preview:react --workspace @mss-claw/web -- --mode test",
    "start:api:prod": "node apps/api/scripts/start-api.mjs production",
    "preview": "npm run preview --workspace @mss-claw/web",
    "preview:react": "npm run preview:react --workspace @mss-claw/web",
    "smoke": "npm run smoke --workspace @mss-claw/web"
  }
}
