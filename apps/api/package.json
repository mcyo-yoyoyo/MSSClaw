{
  "name": "@mss-claw/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test:ai-brief-dedupe": "npm run build --silent && node --test tests/aiBriefEmailRecipients.test.mjs",
    "test:ai-news-sync": "npm run build --silent && node --test tests/aiDailyNewsSync.test.mjs",
    "test:external-tool-layout": "npm run build --silent && node --test tests/externalToolLayout.test.mjs",
    "test:llm-config": "npm run build --silent && node --test tests/llmConfigExecution.test.mjs",
    "test:account-credentials": "npm run build --silent && node --test tests/accountCredentials.test.mjs",
    "test:auth-workspace-isolation": "npm run build --silent && node --test tests/authWorkspaceIsolation.test.mjs",
    "test:market-engagement-auth": "npm run build --silent && node --test tests/marketEngagementAuth.test.mjs tests/marketEngagementEvents.test.mjs tests/marketEngagementCatalog.test.mjs tests/marketEngagementSqlite.test.mjs",
    "test:market-engagement-sqlite": "npm run build --silent && node --test tests/marketEngagementSqlite.test.mjs",
    "test:portal-analytics": "npm run build --silent && node --test tests/portalAnalyticsGuest.test.mjs tests/trustProxy.test.mjs tests/portalAnalyticsSqlite.test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.5.0",
    "compression": "^1.8.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
