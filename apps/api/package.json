{
  "name": "@mss-claw/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test:ai-brief-dedupe": "npm run build --silent && node --test tests/aiBriefEmailRecipients.test.mjs",
    "test:ai-news-sync": "npm run build --silent && node --test tests/aiDailyNewsSync.test.mjs",
    "test:external-tool-layout": "npm run build --silent && node --test tests/externalToolLayout.test.mjs",
    "test:home-featured": "npm run build --silent && node --test tests/homeFeatured.test.mjs",
    "test:llm-config": "npm run build --silent && node --test tests/llmConfigExecution.test.mjs",
    "test:account-credentials": "npm run build --silent && node --test tests/accountCredentials.test.mjs",
    "test:oauth-login": "npm run build --silent && node --test tests/oauthLogin.test.mjs tests/verifyDeployedOAuthLogin.test.mjs",
    "test:auth-workspace-isolation": "npm run build --silent && node --test tests/authWorkspaceIsolation.test.mjs",
    "test:market-engagement-auth": "npm run build --silent && node --test tests/marketEngagementAuth.test.mjs tests/marketEngagementEvents.test.mjs tests/marketEngagementCatalog.test.mjs tests/marketEngagementConcurrency.test.mjs",
    "test:market-engagement-concurrency": "npm run build --silent && node --test tests/marketEngagementConcurrency.test.mjs",
    "test:marketplace-mirror": "npm run build --silent && node --test tests/marketplaceCenterMirror.test.mjs tests/skillDeletion.test.mjs",
    "test:package-upload-limits": "npm run build --silent && node --test tests/packageUploadLimits.test.mjs",
    "test:station-announcements": "npm run build --silent && node --test tests/stationAnnouncementBroadcast.test.mjs",
    "test:portal-analytics": "npm run build --silent && node --test tests/portalAnalyticsGuest.test.mjs tests/trustProxy.test.mjs tests/portalAnalyticsConcurrency.test.mjs",
    "test:ai-knowledge": "npm run build --silent && node --test tests/aiKnowledge.test.mjs",
    "migrate:blobs": "node --env-file-if-exists=.env scripts/migrate-blobs-to-s3.mjs",
    "migrate:sqlite-to-pg": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/migrate-sqlite-to-pg.mjs",
    "migrate:blob-refs": "npm run build --silent && node --env-file-if-exists=.env scripts/migrate-blob-refs.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "import:marketplace": "ts-node --project tsconfig.json scripts/import-marketplace-catalog.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/lib-storage": "^3.1153.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.5.0",
    "compression": "^1.8.1",
    "helmet": "^8.3.0",
    "playwright-core": "^1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^8.10.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
