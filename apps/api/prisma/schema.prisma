generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 表名、列名按 docs/database-design.sql 的下划线命名映射；代码里的模型名、字段名不变。

/// 平台配置：整份 JSON 读写，revision 做乐观锁。第 2 期只有 workspace（原 Workspace 行），后续各期往里加键。
model AppSetting {
  settingKey        String   @id @map("setting_key")
  value             Json
  schemaVersion     Int?     @map("schema_version")
  revision          Int      @default(0)
  updatedByMemberId String?  @map("updated_by_member_id")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_setting")
}

/// 市场内容的聚合互动指标。所有计数由后端原子更新，前端只读取结果。
model MarketEngagement {
  contentId String   @id @map("content_id")
  views     Int      @default(0)
  uses      Int      @default(0)
  likes     Int      @default(0)
  dislikes  Int      @default(0)
  downloads Int      @default(0)
  favorites Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("market_engagement_stat")
}

/// 点赞 / 点踩：每人每个内容一行，vote 为空表示已取消
model MarketUserVote {
  userId    String   @map("member_id")
  contentId String   @map("content_id")
  vote      String?
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([userId, contentId])
  @@map("market_user_vote")
}

/// 市场内容的行为事实。累计表只保存当前总量，本表用于按日期统计浏览、收藏、点赞、点踩与跳转趋势。
model MarketEngagementEvent {
  id           String   @id @default(uuid())
  eventId      String?  @unique @map("event_id")
  contentId    String   @map("content_id")
  assetType    String   @default("unknown") @map("asset_type")
  action       String
  dateKey      String   @map("date_key")
  visitorHash  String?  @map("visitor_hash")
  visitorType  String   @default("user") @map("visitor_type")
  success      Boolean?
  durationMs   Int?     @map("duration_ms")
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  errorCode    String?  @map("error_code")
  /// 分享编号：share 事件记自己的编号，detail_direct 事件记打开的是哪个编号
  shareCode    String?  @map("share_code")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([dateKey, action], map: "market_engagement_event_date_action_idx")
  @@index([shareCode], map: "market_engagement_event_share_code_idx")
  @@index([occurredAt], map: "market_engagement_event_time_idx")
  @@index([dateKey, visitorHash], map: "market_engagement_event_date_visitor_idx")
  @@index([visitorHash, occurredAt], map: "market_engagement_event_visitor_time_idx")
  @@map("market_engagement_event")
}

/// 门户页面访问事实。eventId 保证同一次上报幂等，PV/UV 均由事实记录实时聚合。
model PortalPageView {
  eventId     String   @id @map("event_id")
  dateKey     String   @map("date_key")
  routeKey    String   @map("route_key")
  visitorHash String   @map("visitor_hash")
  visitorType String   @default("user") @map("visitor_type")
  journeyHash String?  @map("journey_hash")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([dateKey, routeKey], map: "portal_page_view_route_idx")
  @@index([dateKey, visitorHash], map: "portal_page_view_visitor_idx")
  @@map("portal_page_view")
}

/// 每日成功登录账号。复合主键保证同一账号当天重复登录只计为一人。
model PortalDailyLogin {
  dateKey      String   @map("date_key")
  visitorHash  String   @map("visitor_hash")
  firstLoginAt DateTime @default(now()) @map("first_login_at") @db.Timestamptz(3)

  @@id([dateKey, visitorHash])
  @@map("portal_daily_login")
}

/// 游客登录墙与成功登录事件。journeyHash 关联同一浏览器，原始 visitorId 不落库。
model PortalConversionEvent {
  eventId     String   @id @map("event_id")
  dateKey     String   @map("date_key")
  eventType   String   @map("event_type")
  action      String?
  routeKey    String?  @map("route_key")
  journeyHash String   @map("journey_hash")
  userHash    String?  @map("user_hash")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([dateKey, eventType], map: "portal_conversion_event_type_idx")
  @@index([journeyHash, eventType, occurredAt], map: "portal_conversion_event_journey_idx")
  @@map("portal_conversion_event")
}

/// AI 快讯邮件订阅。每位用户只有一条当前有效订阅。
model AiBriefEmailSubscription {
  userId       String   @id @map("member_id")
  userName     String   @map("member_name")
  email        String
  subscribedAt DateTime @default(now()) @map("subscribed_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([subscribedAt], map: "ai_brief_email_subscription_time_idx")
  @@index([email], map: "ai_brief_email_subscription_email_idx")
  @@map("ai_brief_email_subscription")
}

/// 海外案例洞察：草稿与线上版本分开，未发布内容不得进入访客接口。
model CaseInsightArticle {
  id                  String    @id @default(uuid())
  sourceCaseId        String?   @unique @map("source_case_id")
  title               String
  summary             String    @default("")
  company             String    @default("")
  sourceUrl           String    @default("") @map("source_url")
  domainIds           Json      @map("domain_ids")
  tags                Json
  draftHtml           String    @default("") @map("draft_html")
  draftMarkdown       String    @map("draft_markdown")
  draftCoverImage     String?   @map("draft_cover_image")
  status              String    @default("draft")
  sortOrder           Int       @default(0) @map("sort_order")
  version             Int       @default(1)
  publishedTitle      String?   @map("published_title")
  publishedSummary    String?   @map("published_summary")
  publishedCompany    String?   @map("published_company")
  publishedSourceUrl  String?   @map("published_source_url")
  publishedDomainIds  Json?     @map("published_domain_ids")
  publishedTags       Json?     @map("published_tags")
  publishedHtml       String?   @map("published_html")
  publishedMarkdown   String?   @map("published_markdown")
  publishedCoverImage String?   @map("published_cover_image")
  publishedVersion    Int?      @map("published_version")
  publishedAt         DateTime? @map("published_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedFromStatus   String?   @map("deleted_from_status")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, sortOrder], map: "case_insight_article_list_idx")
  @@index([updatedAt], map: "case_insight_article_updated_idx")
  @@map("case_insight_article")
}

/// 站内信正文。广播消息使用 toUserId="*"，定向消息保存具体用户 id。
model InboxMessageRecord {
  id         String                  @id
  kind       String
  title      String
  body       String
  fromUserId String?                 @map("from_member_id")
  fromName   String                  @map("from_name")
  toUserId   String                  @map("to_member_id")
  meta       Json?
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  states     InboxUserMessageState[]

  @@index([toUserId, createdAt], map: "inbox_message_to_idx")
  @@map("inbox_message")
}

/// 每个用户独立的消息状态，避免广播消息共享已读/删除状态。
model InboxUserMessageState {
  userId    String             @map("member_id")
  messageId String             @map("message_id")
  readAt    DateTime?          @map("read_at") @db.Timestamptz(3)
  deletedAt DateTime?          @map("deleted_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  message   InboxMessageRecord @relation(fields: [messageId], references: [id], onDelete: Cascade, map: "inbox_message_state_message_id_fkey")

  @@id([userId, messageId])
  @@index([messageId], map: "inbox_message_state_message_idx")
  @@map("inbox_message_state")
}

// ---------------------------------------------------------------------------
// 第 3 期资产表（docs/database-design.sql B1–B7）。字段名与接口 JSON 的键一致，
// 便于整份快照收发；position 保存快照数组顺序（前端新增资产插在最前，顺序即默认展示顺序）。
// createdAt / updatedAt 是行时间，资产自带的同名字符串存在 sourceCreatedAt / sourceUpdatedAt。

/// 工具：原 center_record global-tools 的 tools[]
model Tool {
  no                    BigInt   @id @default(autoincrement())
  id                    String   @unique
  position              Int
  name                  String
  marketTitle           String?  @map("market_title")
  desc                  String   @map("description")
  cardSummary           String?  @map("card_summary")
  category              String
  sourceType            String?  @map("source_type")
  marketShelf           String?  @map("market_shelf")
  region                String?
  company               String?
  author                String
  publisher             String?  @map("publisher_name")
  publisherUserId       String?  @map("publisher_member_id")
  published             Boolean
  visibility            String?
  ownerDeptIds          Json?    @map("owner_dept_ids")
  ownerRegionId         String?  @map("owner_region_id")
  ownerRegionIds        Json?    @map("owner_region_ids")
  icon                  String
  logoUrl               String?  @map("logo_url")
  homepageUrl           String?  @map("homepage_url")
  docsUrl               String?  @map("docs_url")
  mediaUrl              String?  @map("media_url")
  screenshotUrl         String?  @map("screenshot_url")
  versionLabel          String?  @map("version_label")
  deliveryForm          String?  @map("delivery_form")
  connectorType         String?  @map("connector_type")
  toolTypeId            String?  @map("tool_type_id")
  toolTypeIds           Json?    @map("tool_type_ids")
  toolTypeLabels        Json?    @map("tool_type_labels")
  externalCategoryRanks Json?    @map("external_category_ranks")
  externalSortOrder     Int?     @map("external_sort_order")
  externalSortRank      Int?     @map("external_sort_rank")
  bestFor               String?  @map("best_for")
  productIntro          String?  @map("product_intro")
  coreCapabilities      Json?    @map("core_capabilities")
  usageGuide            Json?    @map("usage_guide")
  tags                  Json
  scenarioTags          Json?    @map("scenario_tags")
  businessScenarioIds   Json?    @map("business_scenario_ids")
  invokes               Int      @default(0)
  featuredInFindCases   Boolean? @map("featured_in_find_cases")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("tool")
}

/// Skill：原 marketplace.skills[]
model Skill {
  executionMode String @default("prompt") @map("execution_mode")
  no                  BigInt         @id @default(autoincrement())
  id                  String         @unique
  position            Int
  name                String
  nameZh              String?        @map("name_zh")
  nameEn              String?        @map("name_en")
  desc                String         @map("description")
  descZh              String?        @map("description_zh")
  descEn              String?        @map("description_en")
  category            String
  command             String
  author              String
  publisher           String?        @map("publisher_name")
  publisherUserId     String?        @map("publisher_member_id")
  version             String
  connector           String
  published           Boolean
  callable            Boolean?
  featuredInDoTask    Boolean?       @map("featured_in_do_task")
  featuredInMssMarket Boolean?       @map("featured_in_mss_market")
  businessScenarioId  String?        @map("business_scenario_id")
  sourceType          String?        @map("source_type")
  visibility          String?
  homepageUrl         String?        @map("homepage_url")
  scenarioTags        Json?          @map("scenario_tags")
  invokes             Int            @default(0)
  icon                String
  iconUrl             String?        @map("icon_url")
  accentColor         String?        @map("accent_color")
  tags                Json
  searchKeywords      Json?          @map("search_keywords")
  instructions        String?
  planSteps           Json?          @map("plan_steps")
  usageNotes          String?        @map("usage_notes")
  packageBlob         Json?          @map("package_blob")
  detail              Json?
  traceEvaluation     Json?          @map("trace_evaluation")
  updatedBy           String?        @map("updated_by")
  sourceCreatedAt     String?        @map("source_created_at")
  sourceUpdatedAt     String?        @map("source_updated_at")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  versions            SkillVersion[]
  regions             SkillRegion[]
  domains             SkillDomain[]

  @@map("skill")
}

/// Skill 版本：原 skill.versions[]，position 保持数组顺序
model SkillVersion {
  executionMode String @default("prompt") @map("execution_mode")
  skillNo     BigInt  @map("skill_no")
  version     String
  position    Int
  notes       String?
  status      String?
  packageBlob Json?   @map("package_blob")
  publishedAt String? @map("published_at")
  skill       Skill   @relation(fields: [skillNo], references: [no], onDelete: Cascade, map: "skill_version_skill_no_fkey")

  @@id([skillNo, version])
  @@map("skill_version")
}

/// Agent：原 marketplace.agents[]
model Agent {
  no                  BigInt        @id @default(autoincrement())
  id                  String        @unique
  position            Int
  name                String
  desc                String        @map("description")
  valueProposition    String?       @map("value_proposition")
  category            String
  bizLine             String        @map("biz_line")
  homeTag             String        @map("home_tag")
  author              String
  publisher           String?       @map("publisher_name")
  publisherUserId     String?       @map("publisher_member_id")
  maintainer          String?
  published           Boolean
  featuredInDoTask    Boolean?      @map("featured_in_do_task")
  lifecycleStatus     String?       @map("lifecycle_status")
  businessScenarioId  String?       @map("business_scenario_id")
  sourceType          String?       @map("source_type")
  visibility          String?
  scenarioTags        Json?         @map("scenario_tags")
  capabilityTypeIds   Json?         @map("capability_type_ids")
  invokes             Int           @default(0)
  primarySkillId      String?       @map("primary_skill_id")
  chatId              String        @map("chat_id")
  icon                String
  color               String
  avatarPresetId      String?       @map("avatar_preset_id")
  avatarUrl           String?       @map("avatar_url")
  systemPrompt        String?       @map("system_prompt")
  demoPrompt          String?       @map("demo_prompt")
  demoUrl             String?       @map("demo_url")
  solutionDocUrl      String?       @map("solution_doc_url")
  feedbackUrl         String?       @map("feedback_url")
  installCommand      String?       @map("install_command")
  version             String?
  versionSummary      String?       @map("version_summary")
  requiresHumanReview Boolean?      @map("requires_human_review")
  packageBlob         Json?         @map("package_blob")
  planSteps           Json?         @map("plan_steps")
  detail              Json?
  sourceCreatedAt     String?       @map("source_created_at")
  sourceUpdatedAt     String?       @map("source_updated_at")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  skills              AgentSkill[]
  regions             AgentRegion[]
  domains             AgentDomain[]

  @@map("agent")
}

/// Skill / Agent 的区域、领域标签（接口字段 ownerRegionIds / ownerDeptIds）。没有区域标签 = 全部区域
model SkillRegion {
  skillNo  BigInt @map("skill_no")
  regionId String @map("region_id")
  position Int    @default(0)
  skill    Skill  @relation(fields: [skillNo], references: [no], onDelete: Cascade, map: "skill_region_skill_no_fkey")
  region   Region @relation(fields: [regionId], references: [id], map: "skill_region_region_id_fkey")

  @@id([skillNo, regionId])
  @@index([regionId], map: "skill_region_region_idx")
  @@map("skill_region")
}

model SkillDomain {
  skillNo  BigInt @map("skill_no")
  domainId String @map("domain_id")
  position Int    @default(0)
  skill    Skill  @relation(fields: [skillNo], references: [no], onDelete: Cascade, map: "skill_domain_skill_no_fkey")
  domain   Domain @relation(fields: [domainId], references: [id], map: "skill_domain_domain_id_fkey")

  @@id([skillNo, domainId])
  @@index([domainId], map: "skill_domain_domain_idx")
  @@map("skill_domain")
}

model AgentRegion {
  agentNo  BigInt @map("agent_no")
  regionId String @map("region_id")
  position Int    @default(0)
  agent    Agent  @relation(fields: [agentNo], references: [no], onDelete: Cascade, map: "agent_region_agent_no_fkey")
  region   Region @relation(fields: [regionId], references: [id], map: "agent_region_region_id_fkey")

  @@id([agentNo, regionId])
  @@index([regionId], map: "agent_region_region_idx")
  @@map("agent_region")
}

model AgentDomain {
  agentNo  BigInt @map("agent_no")
  domainId String @map("domain_id")
  position Int    @default(0)
  agent    Agent  @relation(fields: [agentNo], references: [no], onDelete: Cascade, map: "agent_domain_agent_no_fkey")
  domain   Domain @relation(fields: [domainId], references: [id], map: "agent_domain_domain_id_fkey")

  @@id([agentNo, domainId])
  @@index([domainId], map: "agent_domain_domain_idx")
  @@map("agent_domain")
}

/// Agent 编排的 Skill：原 agent.skillIds[]；skill_id 不加外键（可能引用未上架或已删除的 Skill）
model AgentSkill {
  agentNo  BigInt @map("agent_no")
  skillId  String @map("skill_id")
  position Int
  agent    Agent  @relation(fields: [agentNo], references: [no], onDelete: Cascade, map: "agent_skill_agent_no_fkey")

  @@id([agentNo, skillId])
  @@index([skillId], map: "agent_skill_skill_idx")
  @@map("agent_skill")
}

/// 自动化：原 marketplace.automations[]
model Automation {
  id        String   @id
  position  Int
  name      String
  desc      String   @map("description")
  agentId   String   @map("agent_id")
  skillIds  Json     @map("skill_ids")
  schedule  String
  enabled   Boolean
  lastRun   String   @map("last_run")
  icon      String?
  published Boolean?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("automation")
}

/// 知识库文档：原 marketplace.kbDocs[]
model KbDocument {
  id              String   @id
  position        Int
  title           String
  desc            String   @map("description")
  collection      String   @map("collection_id")
  type            String   @map("doc_type")
  size            String   @map("size_label")
  pages           Int
  clearance       String
  indexed         Boolean
  chunks          Int
  author          String
  tags            Json
  chunkTexts      Json?    @map("chunk_texts")
  content         String?
  published       Boolean?
  sourceUpdatedAt String   @map("source_updated_at")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("kb_document")
}

// ---------------------------------------------------------------------------
// 第 4 期身份表（docs/database-design.sql A1–A3、C5）。接口仍是 /docs/members、/docs/auth-credentials 整份收发。

/// 角色：一个成员一个角色；super_admin 全库只能有一个成员（迁移里的部分唯一索引）
model Role {
  id          String     @id
  name        String
  description String?
  isSystem    Boolean    @default(false) @map("is_system")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  members     Member[]
  menus       RoleMenu[]

  @@map("role")
}

/// 菜单：id 即前端视图 id（AppView）
/// 两层菜单：parent_id 为空的是一级分组（只分组、不授权），二级菜单才分配给角色。
/// fixed：所有登录用户都有，不进 role_menu
model Menu {
  id       String     @id
  name     String
  section  String
  icon     String?
  sort     Int        @default(0)
  parentId String?    @map("parent_id")
  fixed    Boolean    @default(false)
  parent   Menu?      @relation("MenuTree", fields: [parentId], references: [id], onDelete: Restrict, map: "menu_parent_id_fkey")
  children Menu[]     @relation("MenuTree")
  roles    RoleMenu[]

  @@index([parentId], map: "menu_parent_idx")
  @@map("menu")
}

/// 角色可见菜单；super_admin 不查这张表，全部放行
/// canEdit=false 时只能看，不能新增、修改、删除
model RoleMenu {
  roleId  String  @map("role_id")
  menuId  String  @map("menu_id")
  canEdit Boolean @default(true) @map("can_edit")
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "role_menu_role_id_fkey")
  menu    Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade, map: "role_menu_menu_id_fkey")

  @@id([roleId, menuId])
  @@index([menuId], map: "role_menu_menu_idx")
  @@map("role_menu")
}

/// 区域字典：成员归属与 Skill / Agent 标签共用
model Region {
  id        String        @id
  name      String
  enabled   Boolean       @default(true)
  sort      Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  members   Member[]
  skills    SkillRegion[]
  agents    AgentRegion[]

  @@map("region")
}

/// 领域字典：成员归属与 Skill / Agent 标签共用（原组织字典里的 depts）
model Domain {
  id        String         @id
  name      String
  enabled   Boolean        @default(true)
  sort      Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  members   MemberDomain[]
  skills    SkillDomain[]
  agents    AgentDomain[]

  @@map("domain")
}

/// 成员：原 doc:members.members[]；position 保持成员表顺序。邮箱一律小写存储（迁移里的 CHECK 约束）
model Member {
  id            String            @id
  email         String            @unique
  externalId    String?           @unique @map("external_id")
  name          String            @map("display_name")
  avatar        String            @default("bg-zinc-600")
  postName      String?           @map("post_name")
  orgPath       String?           @map("org_path")
  roleId        String            @default("member") @map("role_id")
  status        String            @default("active")
  regionId      String?           @map("region_id")
  tokenVersion  Int               @default(0) @map("token_version")
  position      Int               @default(0)
  lastLoginAt   DateTime?         @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  role          Role              @relation(fields: [roleId], references: [id], map: "member_role_id_fkey")
  region        Region?           @relation(fields: [regionId], references: [id], map: "member_region_id_fkey")
  domains       MemberDomain[]
  credential    MemberCredential?
  sessions      AuthSession[]
  refreshTokens RefreshToken[]

  @@index([roleId], map: "member_role_idx")
  @@map("member")
}

/// 成员所属领域（可多个）；position 保持选择顺序
model MemberDomain {
  memberId String @map("member_id")
  domainId String @map("domain_id")
  position Int    @default(0)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "member_domain_member_id_fkey")
  domain   Domain @relation(fields: [domainId], references: [id], map: "member_domain_domain_id_fkey")

  @@id([memberId, domainId])
  @@index([domainId], map: "member_domain_domain_idx")
  @@map("member_domain")
}

/// 成员密码：原 doc:auth-credentials.credentials[email]；sha256(salt + ":" + password)
model MemberCredential {
  memberId          String   @id @map("member_id")
  algorithm         String   @default("sha256-salt")
  salt              String
  passwordHash      String   @map("password_hash")
  passwordUpdatedAt DateTime @map("password_updated_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "member_credential_member_id_fkey")

  @@map("member_credential")
}

/// 登录会话：库里只存令牌的 SHA-256
model AuthSession {
  tokenHash  String    @id @map("token_hash")
  memberId   String    @map("member_id")
  authMethod String    @map("auth_method")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "auth_session_member_id_fkey")

  @@index([memberId], map: "auth_session_member_idx")
  @@index([expiresAt], map: "auth_session_expires_idx")
  @@map("auth_session")
}

/// 刷新令牌：库里只存 SHA-256；每次刷新作废旧的、签发新的（replaced_by 指向新令牌）
model RefreshToken {
  id         String    @id
  memberId   String    @map("member_id")
  tokenHash  String    @unique @map("token_hash")
  authMethod String    @map("auth_method")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "refresh_token_member_id_fkey")

  @@index([memberId], map: "refresh_token_member_idx")
  @@index([expiresAt], map: "refresh_token_expires_idx")
  @@map("refresh_token")
}

/// 整表替换集合的版本号（members / auth-credentials），乐观锁用
model CollectionRevision {
  collection        String   @id
  revision          Int      @default(0)
  updatedByMemberId String?  @map("updated_by_member_id")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("collection_revision")
}

// ---------------------------------------------------------------------------
// 第 5 期个人数据（docs/database-design.sql D1–D5）。按字符串 id 关联成员和资产，不加外键。
// assetType 在旧记录里没有时存空串（主键列不能为空）。

/// 收藏：「谁收藏了什么」只此一份；收藏数仍由 market_engagement_stat.favorites 计数
model MarketFavorite {
  memberId  String   @map("member_id")
  shelfKind String   @map("shelf_kind")
  assetType String   @default("") @map("asset_type")
  assetId   String   @map("asset_id")
  contentId String   @map("content_id")
  title     String
  icon      String?
  logoUrl   String?  @map("logo_url")
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([memberId, shelfKind, assetType, assetId])
  @@index([contentId], map: "market_favorite_content_idx")
  @@index([memberId, contentId], map: "market_favorite_member_content_idx")
  @@map("market_favorite")
}

/// 最近浏览：每人保留最近 12 条
model MarketRecentView {
  memberId  String   @map("member_id")
  shelfKind String   @map("shelf_kind")
  assetType String   @default("") @map("asset_type")
  assetId   String   @map("asset_id")
  title     String
  icon      String?
  logoUrl   String?  @map("logo_url")
  viewedAt  DateTime @map("viewed_at") @db.Timestamptz(3)

  @@id([memberId, shelfKind, assetType, assetId])
  @@map("market_recent_view")
}

/// 用户隐藏的货架项
model MarketHiddenItem {
  memberId  String   @map("member_id")
  shelfKind String   @map("shelf_kind")
  assetId   String   @map("asset_id")
  hiddenAt  DateTime @default(now()) @map("hidden_at") @db.Timestamptz(3)

  @@id([memberId, shelfKind, assetId])
  @@map("market_hidden_item")
}

/// Skill 评价：每个 Skill 最多保留 80 条
model SkillReview {
  id         String    @id
  skillId    String    @map("skill_id")
  memberId   String    @map("member_id")
  memberName String    @map("member_name")
  rating     Int       @db.SmallInt
  content    String
  reply      String?
  repliedAt  DateTime? @map("replied_at") @db.Timestamptz(3)
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([skillId, createdAt], map: "skill_review_skill_idx")
  @@map("skill_review")
}

// ---------------------------------------------------------------------------
// 第 6 期其余文档（docs/database-design.sql A4、B8、B9、C1–C4、E3–E5、F1–F4）。
// 接口 JSON 自带的时间（毫秒或 ISO 字符串）直接存进对应列；只用来原样返回、不参与排序的 ISO 字符串存文本。

/// 内部办公场景：原 doc:internal-office-scenes.entries[]；整表替换用 collection_revision('office-scenes')
model OfficeScene {
  id          String   @id
  position    Int
  label       String
  english     String
  description String
  icon        String
  visible     Boolean
  toolId      String?  @map("tool_id")
  toolBlurb   String?  @map("tool_blurb")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("office_scene")
}

/// 原型中心资源：prompt / workflow / knowledge / memory，嵌套深，整体存 jsonb
model CenterResource {
  kind      String
  id        String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([kind, id])
  @@map("center_resource")
}

/// 门户知识地图内容：原 center_record portal-content 的 items[]；整表替换用 collection_revision('portal-content')
model PortalContent {
  id                String   @id
  position          Int
  type              String
  title             String
  desc              String   @map("description")
  icon              String
  published         Boolean?
  isGold            Boolean? @map("is_gold")
  sourceType        String?  @map("source_type")
  visibility        String?
  publisher         String?  @map("publisher_name")
  publisherUserId   String?  @map("publisher_member_id")
  ownerDeptIds      Json?    @map("owner_dept_ids")
  ownerRegionId     String?  @map("owner_region_id")
  scenarioTags      Json?    @map("scenario_tags")
  homepageUrl       String?  @map("homepage_url")
  kbDocId           String?  @map("kb_doc_id")
  agentId           String?  @map("agent_id")
  skillId           String?  @map("skill_id")
  primarySkillId    String?  @map("primary_skill_id")
  toolId            String?  @map("tool_id")
  painPoint         String?  @map("pain_point")
  impactMetric      String?  @map("impact_metric")
  steps             Json?
  packageVersion    String?  @map("package_version")
  previewFile       Json?    @map("preview_file")
  layoutPreviewFile Json?    @map("layout_preview_file")
  publishedAt       String   @map("published_at")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("portal_content")
}

/// 资产审批单：原 doc:asset-approvals.items[]；时间来自前端毫秒数
model AssetApproval {
  id                String    @id
  position          Int
  kind              String    @map("asset_kind")
  assetId           String    @map("asset_id")
  assetName         String    @map("asset_name")
  submitterUserId   String?   @map("submitter_member_id")
  submitterName     String    @map("submitter_name")
  stepIndex         Int       @map("step_index") @db.SmallInt
  status            String
  reasons           Json?
  note              String?
  rejectNote        String?   @map("reject_note")
  targetVersion     String?   @map("target_version")
  packageBlob       Json?     @map("package_blob")
  unpublishMode     String?   @map("unpublish_mode")
  unpublishVersions Json?     @map("unpublish_versions")
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz(3)
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  @@index([kind, assetId, status], map: "asset_approval_asset_idx")
  @@map("asset_approval")
}

/// 审批关注：原 doc:asset-approvals.watchedByUserId[uid][]
model AssetApprovalWatch {
  memberId  String   @map("member_id")
  kind      String   @map("asset_kind")
  assetId   String   @map("asset_id")
  assetName String   @map("asset_name")
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([memberId, kind, assetId])
  @@map("asset_approval_watch")
}

/// 审计日志：只追加，保留 180 天
model AuditLog {
  no         BigInt   @id @default(autoincrement()) @map("id")
  entryId    String   @unique @map("entry_id")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  category   String
  action     String
  module     String
  detail     String
  actorName  String   @map("actor_name")
  actorEmail String?  @map("actor_email")
  actorRole  String?  @map("actor_role")
  deptIds    Json?    @map("dept_ids")
  regionId   String?  @map("region_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([occurredAt], map: "audit_log_time_idx")
  @@map("audit_log")
}

/// 站内公告：原 doc:station-announcements.items[]；整表替换用 collection_revision('station-announcements')
model StationAnnouncement {
  id          String   @id
  position    Int
  title       String
  body        String
  badge       String
  badgeColor  String?  @map("badge_color")
  pinned      Boolean  @default(false)
  /// false 表示已下架：首页和我的消息不展示，记录仍保留
  listed      Boolean  @default(true)
  publishedAt String   @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("station_announcement")
}

/// 运营发布的 AI 新闻：原 doc:ai-news.items[]
model AiNewsPost {
  id          String   @id
  position    Int
  title       String
  summary     String?
  body        String
  cadence     String
  source      String?
  publishedAt String   @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_news_post")
}

/// AIHOT 快讯归档：原 doc-ai-news-archive.items[]；同步状态在 app_setting('ai-news-feed.sync')
model AiNewsFeedItem {
  id          String   @id
  publishedAt String   @map("published_at")
  dateLabel   String   @map("date_label")
  title       String
  summary     String
  url         String
  source      String?
  category    String?
  reason      String?
  score       Int?
  aihotUrl    String?  @map("aihot_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([publishedAt], map: "ai_news_feed_item_published_idx")
  @@map("ai_news_feed_item")
}

/// 执行记录：原 center_record kind=execution
model Execution {
  skillRuns SkillRun[]
  id           String    @id
  userId       String?   @map("member_id")
  chatId       String    @map("chat_id")
  assetType    String    @map("asset_type")
  assetId      String    @map("asset_id")
  agentType    String    @map("agent_type")
  agentName    String    @map("agent_name")
  status       String
  source       String?
  message      String
  error        String?
  totalTime    String?   @map("total_time_label")
  inputTokens  Int?      @map("input_tokens")
  outputTokens Int?      @map("output_tokens")
  hasUsage     Boolean   @default(false) @map("has_usage")
  steps        Json?
  startedAt    DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt], map: "execution_updated_idx")
  @@map("execution")
}

/// AI 智库需求草稿：owner 原来编码进主键，现在是普通列
model AiKnowledgeDraft {
  id                 String   @id
  ownerKey           String   @map("owner_key")
  ownerMemberId      String?  @map("owner_member_id")
  scenarioId         String   @map("scenario_id")
  originalQuestion   String   @map("original_question")
  demand             Json
  messages           Json
  clarificationCount Int      @map("clarification_count") @db.SmallInt
  createdAt          DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([ownerKey, updatedAt], map: "ai_knowledge_draft_owner_idx")
  @@map("ai_knowledge_draft")
}

/// AI 智库方案：生成后不再修改；正文（需求、对话、行动、证据等）整体存 content
model AiKnowledgeSolution {
  id               String   @id
  ownerKey         String   @map("owner_key")
  ownerMemberId    String?  @map("owner_member_id")
  scenarioId       String   @map("scenario_id")
  title            String
  domain           String
  maturity         String
  generationSource String   @map("generation_source")
  model            String?
  originalQuestion String   @map("original_question")
  content          Json
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)

  @@index([ownerKey, createdAt], map: "ai_knowledge_solution_owner_idx")
  @@map("ai_knowledge_solution")
}

/// 模型目录：原 doc:llm-config.platformModels[] / customModels[]；api_key 加密存储（enc:v1:...）
model LlmModelConfig {
  scope        String
  modelId      String   @map("model_id")
  position     Int
  source       String?
  label        String
  providerName String?  @map("provider_name")
  baseUrl      String   @map("base_url")
  apiKey       String?  @map("api_key")
  enabled      Boolean?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([scope, modelId])
  @@map("llm_model_config")
}

/// 对话 / 任务会话：原 app_setting('workspace').catalog.chats；个人会话只给本人，WarRoom 给成员
model ChatSession {
  id                 String    @id
  ownerUserId        String?   @map("owner_member_id")
  ownerEmail         String?   @map("owner_email")
  type               String
  sessionGroup       String?   @map("session_group")
  title              String
  status             String?
  icon               String
  iconBg             String?   @map("icon_bg")
  color              String
  badge              String?
  agentId            String?   @map("agent_id")
  skillId            String?   @map("skill_id")
  actionType         String?   @map("action_type")
  taskSource         String?   @map("task_source")
  businessScenarioId String?   @map("business_scenario_id")
  adminId            String?   @map("admin_member_id")
  members            Json?
  prompts            Json
  history            Json
  pinnedAt           DateTime? @map("pinned_at") @db.Timestamptz(3)
  createdAt          DateTime? @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([ownerUserId, updatedAt], map: "chat_session_owner_idx")
  @@map("chat_session")
}

model SkillRun {
  id String @id
  memberId String @map("member_id")
  skillId String @map("skill_id")
  skillVersion String @map("skill_version")
  executionId String? @map("execution_id")
  execution Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  status String @default("queued")
  inputBlobIds Json @map("input_blob_ids")
  artifacts Json @default("[]")
  packageBlob Json @map("package_blob")
  error String?
  attempt Int @default(0)
  lockedBy String? @map("locked_by")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  cancelRequested Boolean @default(false) @map("cancel_requested")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  events SkillRunEvent[]
  @@index([status, createdAt])
  @@index([memberId, createdAt])
  @@map("skill_run")
}

model SkillRunEvent {
  runId String @map("run_id")
  seq Int
  type String
  payload Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  run SkillRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@id([runId, seq])
  @@map("skill_run_event")
}

model SkillRunInput {
  blobId String @id @map("blob_id")
  memberId String @map("member_id")
  @@map("skill_run_input")
}
