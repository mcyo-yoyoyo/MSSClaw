generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id            String   @id
  name          String
  namespace     String
  description   String
  memberCount   Int      @default(0)
  defaultChatId String
  catalogJson   Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CenterRecord {
  id          String   @id
  workspaceId String
  kind        String
  payload     Json
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, kind])
}

/// 市场内容的聚合互动指标。所有计数由后端原子更新，前端只读取结果。
model MarketEngagement {
  workspaceId String
  contentId   String
  views       Int      @default(0)
  uses        Int      @default(0)
  likes       Int      @default(0)
  dislikes    Int      @default(0)
  downloads   Int      @default(0)
  favorites   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([workspaceId, contentId])
  @@index([workspaceId, updatedAt])
}

/// 用户对市场内容的状态，用于保证点赞/点踩/收藏幂等且按用户隔离。
model MarketUserInteraction {
  workspaceId String
  userId      String
  contentId   String
  vote        String?
  favorited   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@id([workspaceId, userId, contentId])
  @@index([workspaceId, userId, favorited])
}

/// 门户页面访问事实。eventId 保证同一次上报幂等，PV/UV 均由事实记录实时聚合。
model PortalPageView {
  workspaceId String
  eventId     String
  dateKey     String
  routeKey    String
  visitorHash String
  visitorType String   @default("user")
  journeyHash String?
  occurredAt  DateTime @default(now())

  @@id([workspaceId, eventId])
  @@index([workspaceId, dateKey])
  @@index([workspaceId, dateKey, routeKey])
  @@index([workspaceId, dateKey, visitorHash])
  @@index([workspaceId, dateKey, visitorType])
  @@index([workspaceId, dateKey, journeyHash])
}

/// 每日成功登录账号。复合主键保证同一账号当天重复登录只计为一人。
model PortalDailyLogin {
  workspaceId  String
  dateKey      String
  visitorHash  String
  firstLoginAt DateTime @default(now())

  @@id([workspaceId, dateKey, visitorHash])
  @@index([workspaceId, dateKey])
}

/// 游客登录墙与成功登录事件。journeyHash 关联同一浏览器，原始 visitorId 不落库。
model PortalConversionEvent {
  workspaceId String
  eventId     String
  dateKey     String
  eventType   String
  action      String?
  routeKey    String?
  journeyHash String
  userHash    String?
  occurredAt  DateTime @default(now())

  @@id([workspaceId, eventId])
  @@index([workspaceId, dateKey, eventType])
  @@index([workspaceId, dateKey, journeyHash])
  @@index([workspaceId, dateKey, action])
  @@index([workspaceId, journeyHash, eventType, occurredAt])
}

/// AI 快讯邮件订阅。每个工作区内每位用户只有一条当前有效订阅。
model AiBriefEmailSubscription {
  workspaceId  String
  userId       String
  userName     String
  email        String
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([workspaceId, userId])
  @@index([workspaceId, subscribedAt])
  @@index([workspaceId, email])
}

/// 工作区消息正文。广播消息使用 toUserId="*"，定向消息保存具体用户 id。
model InboxMessageRecord {
  workspaceId String
  id          String
  kind        String
  title       String
  body        String
  fromUserId  String?
  fromName    String
  toUserId    String
  meta        Json?
  createdAt   DateTime @default(now())

  @@id([workspaceId, id])
  @@index([workspaceId, toUserId, createdAt])
}

/// 每个用户独立的消息状态，避免广播消息共享已读/删除状态。
model InboxUserMessageState {
  workspaceId String
  userId      String
  messageId   String
  readAt      DateTime?
  deletedAt   DateTime?
  updatedAt   DateTime @updatedAt

  @@id([workspaceId, userId, messageId])
  @@index([workspaceId, userId, deletedAt])
}
